{
  "name": "mern-ecommerce-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MERN e-commerce API server (Express + Mongoose)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "overrides": {
    "brace-expansion": "5.0.5",
    "ip-address": "10.1.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "0.44.0",
    "cloudinary": "2.9.0",
    "connect-mongo": "^5.1.0",
    "cors": "2.8.6",
    "dotenv": "17.4.0",
    "express": "5.2.0",
    "express-rate-limit": "8.3.2",
    "express-session": "^1.18.0",
    "helmet": "8.1.0",
    "mongoose": "9.3.3",
    "multer": "2.1.1",
    "nodemailer": "8.0.4",
    "short-unique-id": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "^1.18.0",
    "@types/multer": "2.1.0",
    "@types/node": "25.5.0",
    "@types/nodemailer": "7.0.11",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.27.7": true
  }
}
